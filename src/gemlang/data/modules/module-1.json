  "vocabulary": {
    "hola": {
      "mnemonic": "Sounds like 'holler' — you holler 'Hello!'",
      "explanation": "Universal greeting, any time of day."
    },
    "buenos": {
      "mnemonic": "Think 'bonus' — it's a bonus to have a good day!",
      "explanation": "Masculine plural of 'bueno' (good)."
    },
    "días": {
      "mnemonic": "Think 'diaries' — you write in your diary each day.",
      "explanation": "Plural of 'día' (day)."
    },
    "buenas": {
      "mnemonic": "Same root as 'bonus' — feminine plural of 'bueno'.",
      "explanation": "Used with feminine nouns like tardes, noches."
    },
    "tardes": {
      "mnemonic": "Sounds like 'tardy' — being late in the afternoon.",
      "explanation": "Plural of 'tarde' (afternoon/evening)."
    },
    "noches": {
      "mnemonic": "Sounds like 'notches' — notch each night off.",
      "explanation": "Plural of 'noche' (night)."
    },
    "adiós": {
      "mnemonic": "Think 'adios amigos!' — a dramatic farewell.",
      "explanation": "From 'a Dios' (to God). More final than 'hasta luego'."
    },
    "hasta": {
      "mnemonic": "'Hasta la vista, baby!' — until we meet again.",
      "explanation": "Means 'until'. Used in many farewell phrases."
    },
    "luego": {
      "mnemonic": "Sounds like 'Lego' — I'll play Lego with you later.",
      "explanation": "Means 'later' or 'then'."
    },
    "favor": {
      "mnemonic": "Same as English 'favor' — do me a favor, please!",
      "explanation": "'Por favor' literally means 'for favor'."
    },
    "gracias": {
      "mnemonic": "Think 'gracious' — a gracious person says thank you.",
      "explanation": "From Latin 'gratia' (grace/thanks)."
    },
    "muchas": {
      "mnemonic": "Sounds like 'much-as' — many/much.",
      "explanation": "Feminine plural of 'mucho'."
    },
    "nada": {
      "mnemonic": "'Nada, zip, zilch' — nothing at all!",
      "explanation": "'De nada' = 'of nothing' = you're welcome."
    },
    "soy": {
      "mnemonic": "Think 'soy sauce' — silly but memorable 'I am'!",
      "explanation": "First person of 'ser' (to be, permanent)."
    },
    "eres": {
      "mnemonic": "Sounds like 'air is' — 'You are like air.'",
      "explanation": "Informal 'you are' form of 'ser'."
    },
    "quién": {
      "mnemonic": "Sounds like 'key-en' — 'Who has the key?'",
      "explanation": "Question word meaning 'who'."
    },
    "estudiante": {
      "mnemonic": "Nearly identical to 'student' — easy cognate!",
      "explanation": "Works for both male and female students."
    },
    "él": {
      "mnemonic": "Like 'el' in 'elevator' — he goes up!",
      "explanation": "Subject pronoun 'he'. Accent distinguishes from 'el' (the)."
    },
    "es": {
      "mnemonic": "Sounds like letter 'S' — 'He/She is S-uper.'",
      "explanation": "Third person singular of 'ser'."
    },
    "ella": {
      "mnemonic": "Think 'Cinderella' ends with '-ella' — she!",
      "explanation": "Subject pronoun 'she/her'."
    },
    "somos": {
      "mnemonic": "'So most awesome' — we are!",
      "explanation": "First person plural of 'ser'."
    },
    "son": {
      "mnemonic": "Like English 'son' — 'They are my sons.'",
      "explanation": "Third person plural of 'ser'."
    },
    "ustedes": {
      "mnemonic": "Think 'you-sted-es' — all of you!",
      "explanation": "In Spain this is formal only; everyday plural 'you all' is vosotros."
    },
    "y": {
      "mnemonic": "The letter 'Y' connects — like 'and' connects words.",
      "explanation": "Pronounced like 'ee'. The simplest conjunction."
    },
    "mi": {
      "mnemonic": "Sounds like 'me' — what belongs to me is 'mi'.",
      "explanation": "Possessive 'my'. No accent (unlike 'mí' = me)."
    },
    "amigo": {
      "mnemonic": "Already used in English — a friendly buddy.",
      "explanation": "Male friend. 'Amiga' for female."
    },
    "tu": {
      "mnemonic": "Sounds like 'to' — what belongs to you.",
      "explanation": "Possessive 'your'. No accent (unlike 'tú' = you)."
    },
    "amiga": {
      "mnemonic": "Feminine version of 'amigo' — your gal pal.",
      "explanation": "Female friend. Note the -a ending."
    }
  }
}
