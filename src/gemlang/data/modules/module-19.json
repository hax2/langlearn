  "grammarExplanation": "The subjunctive is also triggered by expressions of hope and emotion:\n\n'Espero que + subjunctive'\n\n• Espero que hables = I hope you speak\n• Espero que vengas = I hope you come\n• Espero que estés bien = I hope you're well\n\nOther triggers: 'Ojalá que' (I wish that), 'Me alegra que' (I'm glad that), 'Temo que' (I fear that).\n\nRemember: same subject → infinitive. Different subjects → subjunctive.",
  "vocabulary": {
    "espero": {
      "mnemonic": "Hook phrase: 'Espero que sí' (I hope so).",
      "explanation": "First person of 'esperar'."
    },
    "aquí": {
      "mnemonic": "Hook phrase: 'Ven aquí' (Come here).",
      "explanation": "Means 'here'. More precise than 'acá'."
    },
    "hoy": {
      "mnemonic": "Hook phrase: 'Hoy en día' (Nowadays / Today).",
      "explanation": "Means 'today'."
    },
    "mañana": {
      "mnemonic": "Hook phrase: 'Hasta mañana' (See you tomorrow).",
      "explanation": "Means 'tomorrow' or 'morning'."
    },
    "la": {
      "mnemonic": "Hook phrase: 'La casa' (The house).",
      "explanation": "Also 'the' (feminine)."
    },
    "puerta": {
      "mnemonic": "Etymology: From Latin 'porta'. Cognate with English 'portal' or 'port'.",
      "explanation": "Feminine noun meaning door/gate."
    },
    "ventana": {
      "mnemonic": "Etymology: From Latin 'ventus' (wind). A window acts as a 'vent' for air.",
      "explanation": "From Latin 'ventus' (wind)."
    },
    "lo": {
      "mnemonic": "Hook phrase: 'Lo veo' (I see it).",
      "explanation": "Masculine direct object pronoun."
    },
    "tiempo": {
      "mnemonic": "Etymology: From Latin 'tempus'. Cognate with 'tempo' or 'temporary'.",
      "explanation": "Means 'time' or 'weather'."
    },
    "dinero": {
      "mnemonic": "Etymology: Derived from the ancient Roman coin 'denarius' (like the dinar).",
      "explanation": "Means 'money'."
    },
    "feliz": {
      "mnemonic": "Etymology: From Latin 'felix'. Cognate with English 'felicity'.",
      "explanation": "Same for masc/fem."
    },
    "esperas": {
      "mnemonic": "Hook phrase: '¿Qué esperas?' (What are you waiting for?).",
      "explanation": "Second person of 'esperar'."
    },
    "temprano": {
      "mnemonic": "Etymology: From Latin 'temporanus'. Related to 'tiempo' (time/temporary).",
      "explanation": "Means 'early'."
    },
    "tarde": {
      "mnemonic": "Etymology: From Latin 'tardus' (slow). Cognate with English 'tardy'.",
      "explanation": "Means 'late' or 'afternoon'."
    },
    "pan": {
      "mnemonic": "Etymology: From Latin 'panis'. A 'pantry' is a place to store bread. A 'companion' is someone you share bread with.",
      "explanation": "Means 'bread'. Masculine noun."
    },
    "los": {
      "mnemonic": "Hook phrase: 'Los amigos' (The friends).",
      "explanation": "Direct object pronoun."
    },
    "las": {
      "mnemonic": "Hook phrase: 'Las cosas' (The things).",
      "explanation": "Direct object pronoun."
    }
  }
