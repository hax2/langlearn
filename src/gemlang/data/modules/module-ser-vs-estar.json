{
  "id": "module-ser-vs-estar",
  "title": "Grammar: Ser vs. Estar I",
  "description": "Core ser/estar practice: identity, location, origin, and conditions.",
  "level": "Beginner",
  "specialPractice": "ser-estar-rules",
  "sentences": [],
  "grammarExplanation": "This short special module builds ser vs. estar a few rules at a time. In each rule phase, choose the right form in the blank first. The audio reads the sentence up to the blank, then reads the correct continuation after you choose. Missed choices come back before the phase is over. After each set, translate five mixed-up sentences from English to Spanish.",
  "rules": [
    {
      "id": "identity-definition",
      "name": "Ser: identity and definitions",
      "explanation": "Use ser to say what someone or something is: identity, category, role, or definition.",
      "examples": [
        {
          "prompt": "Ella",
          "correct": "es",
          "continuation": "mi amiga.",
          "options": [
            "es",
            "está"
          ],
          "reason": "Being someone's friend is an identity or relationship, so use ser."
        },
        {
          "prompt": "Nosotros",
          "correct": "somos",
          "continuation": "estudiantes.",
          "options": [
            "somos",
            "estamos"
          ],
          "reason": "Student is a role or identity, so use ser."
        },
        {
          "prompt": "Este animal",
          "correct": "es",
          "continuation": "un gato.",
          "options": [
            "es",
            "está"
          ],
          "reason": "You are identifying what the animal is, so use ser."
        },
        {
          "prompt": "Yo",
          "correct": "soy",
          "continuation": "la hermana de Ana.",
          "options": [
            "soy",
            "estoy"
          ],
          "reason": "Family identity uses ser."
        },
        {
          "prompt": "Ellos",
          "correct": "son",
          "continuation": "mis vecinos.",
          "options": [
            "son",
            "están"
          ],
          "reason": "Neighbor is an identity/relationship, so use ser."
        },
        {
          "prompt": "La capital de España",
          "correct": "es",
          "continuation": "Madrid.",
          "options": [
            "es",
            "está"
          ],
          "reason": "This defines or identifies the capital, so use ser."
        },
        {
          "prompt": "Tú",
          "correct": "eres",
          "continuation": "la persona correcta.",
          "options": [
            "eres",
            "estás"
          ],
          "reason": "This identifies who the person is, so use ser."
        },
        {
          "prompt": "Estos libros",
          "correct": "son",
          "continuation": "diccionarios.",
          "options": [
            "son",
            "están"
          ],
          "reason": "You are classifying the books, so use ser."
        },
        {
          "prompt": "Mi padre",
          "correct": "es",
          "continuation": "el director.",
          "options": [
            "es",
            "está"
          ],
          "reason": "Director is an identifying role here, so use ser."
        },
        {
          "prompt": "La pregunta",
          "correct": "es",
          "continuation": "un problema de gramática.",
          "options": [
            "es",
            "está"
          ],
          "reason": "You are defining what kind of problem it is, so use ser."
        }
      ],
      "translations": [
        {
          "english": "She is the correct person.",
          "spanish": "Ella es la persona correcta.",
          "reason": "Identity uses ser."
        },
        {
          "english": "These books are dictionaries.",
          "spanish": "Estos libros son diccionarios.",
          "reason": "A category or definition uses ser."
        },
        {
          "english": "I am Ana's sister.",
          "spanish": "Yo soy la hermana de Ana.",
          "reason": "Family identity uses ser."
        },
        {
          "english": "The animal is a cat.",
          "spanish": "El animal es un gato.",
          "reason": "Identifying what something is uses ser."
        },
        {
          "english": "We are students.",
          "spanish": "Nosotros somos estudiantes.",
          "reason": "A role or identity uses ser."
        }
      ]
    },
    {
      "id": "location-position",
      "name": "Estar: location and position",
      "explanation": "Use estar to say where a person or thing is located or positioned. The main exception is event location, which uses ser.",
      "examples": [
        {
          "prompt": "Yo",
          "correct": "estoy",
          "continuation": "en casa.",
          "options": [
            "soy",
            "estoy"
          ],
          "reason": "Physical location uses estar."
        },
        {
          "prompt": "El libro",
          "correct": "está",
          "continuation": "en la mesa.",
          "options": [
            "es",
            "está"
          ],
          "reason": "Location of an object uses estar."
        },
        {
          "prompt": "Mis padres",
          "correct": "están",
          "continuation": "en Madrid.",
          "options": [
            "son",
            "están"
          ],
          "reason": "Where people are uses estar."
        },
        {
          "prompt": "Nosotros",
          "correct": "estamos",
          "continuation": "cerca del parque.",
          "options": [
            "somos",
            "estamos"
          ],
          "reason": "Location uses estar."
        },
        {
          "prompt": "La tienda",
          "correct": "está",
          "continuation": "al lado del banco.",
          "options": [
            "es",
            "está"
          ],
          "reason": "The location of a place uses estar."
        },
        {
          "prompt": "Tú",
          "correct": "estás",
          "continuation": "delante de la puerta.",
          "options": [
            "eres",
            "estás"
          ],
          "reason": "Position uses estar."
        },
        {
          "prompt": "Las sillas",
          "correct": "están",
          "continuation": "en el jardín.",
          "options": [
            "son",
            "están"
          ],
          "reason": "Location uses estar."
        },
        {
          "prompt": "El teléfono",
          "correct": "está",
          "continuation": "debajo del cuaderno.",
          "options": [
            "es",
            "está"
          ],
          "reason": "Position uses estar."
        },
        {
          "prompt": "La escuela",
          "correct": "está",
          "continuation": "en el centro.",
          "options": [
            "es",
            "está"
          ],
          "reason": "The physical location of a building uses estar."
        },
        {
          "prompt": "Ellos",
          "correct": "están",
          "continuation": "aquí.",
          "options": [
            "son",
            "están"
          ],
          "reason": "Being here is location, so use estar."
        }
      ],
      "translations": [
        {
          "english": "The phone is under the notebook.",
          "spanish": "El teléfono está debajo del cuaderno.",
          "reason": "Position uses estar."
        },
        {
          "english": "We are near the park.",
          "spanish": "Nosotros estamos cerca del parque.",
          "reason": "Location uses estar."
        },
        {
          "english": "The chairs are in the garden.",
          "spanish": "Las sillas están en el jardín.",
          "reason": "Object location uses estar."
        },
        {
          "english": "The store is next to the bank.",
          "spanish": "La tienda está al lado del banco.",
          "reason": "Physical location uses estar."
        },
        {
          "english": "They are here.",
          "spanish": "Ellos están aquí.",
          "reason": "Here is location, so use estar."
        }
      ]
    },
    {
